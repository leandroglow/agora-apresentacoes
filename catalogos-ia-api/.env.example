OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Acesso Google OAuth somente leitura. Use uma conta Google dedicada que enxergue
# apenas a pasta de catálogos autorizada.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_HINT=https://drive.google.com/drive/folders/ID_DA_PASTA
# Opcional: GOOGLE_DRIVE_FOLDER_ID tem prioridade sobre o link acima.

# Apenas para teste temporário. Em produção, prefira o refresh token acima.
# GOOGLE_DRIVE_OAUTH_ACCESS_TOKEN=

SESSION_SECRET=
AGORA_USERS_JSON={"usuario":"troque-esta-senha"}
ALLOWED_ORIGINS=https://apresentacoes.agoracons.com.br,http://127.0.0.1:8767
